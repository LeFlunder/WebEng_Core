{
  "name": "webeng-projekt",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "scripts": {
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "backend:build": "nx build backend",
    "backend:start": "node dist/apps/backend/main.js",
    "backend:start:dev": "nx build backend && node dist/apps/backend/main.js",
    "backend:start:debug": "nx build backend && node --inspect dist/apps/backend/main.js",
    "backend:test": "nx test backend",
    "backend:test:e2e": "nx e2e backend",
    "backend:lint": "nx lint backend",
    "backend:format": "prettier --write \"apps/backend/src/**/*.ts\" \"apps/backend/test/**/*.ts\"",
    "frontend:build": "nx build frontend",
    "frontend:start": "nx serve frontend",
    "frontend:test": "nx test frontend",
    "frontend:lint": "nx lint frontend",
    "frontend:format": "prettier --write \"apps/frontend/src/**/*.ts\" \"apps/frontend/src/**/*.html\" \"apps/frontend/src/**/*.scss\"",
    "format": "prettier --write \"apps/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,html,scss,json}\"",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "build": "nx run-many --target=build --all"
  },
  "dependencies": {
    "@angular/common": "21.2.9",
    "@angular/compiler": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/forms": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/platform-browser-dynamic": "21.2.9",
    "@angular/router": "21.2.9",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.29",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.0.1",
    "@angular/build": "22.0.1",
    "@angular/cli": "22.0.1",
    "@angular/compiler-cli": "22.0.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.26",
    "@nx/angular": "22.7.5",
    "@nx/eslint": "22.7.5",
    "@nx/jest": "22.7.5",
    "@nx/nest": "22.7.5",
    "@nx/node": "22.7.5",
    "@nx/workspace": "22.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.0.0",
    "angular-eslint": "22.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^16.2.0",
    "jsdom": "^29.1.1",
    "nx": "22.7.5",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
